<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="4dp" /><solid android:color="#26FFFFFF" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape><corners android:radius="4dp" /><gradient android:angle="0" android:startColor="#7B5CFF" android:centerColor="#4E6BFF" android:endColor="#1FC9A2" /></shape>
        </clip>
    </item>
</layer-list>
